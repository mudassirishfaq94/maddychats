# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# environment & secrets — NEVER commit real env files
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.apk
*.aab
*.apks
**/key.properties
**/local.properties
**/twa-manifest.json
**/bubblewrap-config.json
secrets/

# database
*.db
*.sqlite
*.dump
*.backup
*.bak
/backups/

# user-uploaded media — NEVER commit uploaded files
server/uploads/**
!server/uploads/avatars/.gitkeep
!server/uploads/images/.gitkeep
!server/uploads/files/.gitkeep
server/postgres-data/
server/postgres.log

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle
/drizzle/meta
!/drizzle/meta/
/drizzle/meta/*
!/drizzle/meta/_journal.json

# Rust/WebAssembly build output (reproducible from signal-bridge/)
/signal-bridge/target/
/signal-bridge/pkg/
/signal-bridge/public/

# Type declarations emitted beside the deployable Signal WebAssembly assets.
/public/signal/*.d.ts

# one-time QA transfer artifacts — never commit
public/downloads/

# local preview tooling and logs
.freebuff/

# Supabase CLI local project metadata
/supabase/.temp/

# Android build outputs and local signing material
/android/build/
/android/app/build/
/android/.gradle/
/android/local.properties
/android/*.apk
/android/*.aab
/android/capacitor-cordova-android-plugins/build/
/android/signing/
/android/app/src/main/assets/capacitor.plugins.json
/android/app/src/main/assets/capacitor.config.json
/out/
/ios/

# Isolated TWA generation, release artifacts and local signing configuration
/android-twa/project/
/android-twa/release/
/android-twa/signing/
/android-twa/node_modules/
/android-twa/.local/

# Deployment-specific Android Firebase client configuration (not a server credential)
/android/app/google-services.json

# Python verification-tool bytecode caches
__pycache__/
*.py[cod]
/server/staged-media/
