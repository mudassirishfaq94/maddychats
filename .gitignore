# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# environment & secrets — NEVER commit real env files
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/

# database
*.db
*.sqlite
*.dump
*.backup
*.bak

# user-uploaded media — NEVER commit uploaded files
server/uploads/**
!server/uploads/avatars/.gitkeep
!server/uploads/images/.gitkeep
!server/uploads/files/.gitkeep
server/postgres-data/
server/postgres.log

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle
/drizzle/meta
!/drizzle/meta/
/drizzle/meta/*
!/drizzle/meta/_journal.json

# one-time QA transfer artifacts — never commit
public/downloads/

# local preview tooling and logs
.freebuff/
