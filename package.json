{
  "name": "nextjs-postgresql-template",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "node scripts/harden-braces.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:online": "node scripts/migrate-online-index.mjs up",
    "test:database-index": "tsx scripts/test-database-index.ts",
    "test:cache": "node scripts/test-public-cache.mjs",
    "test:load": "node scripts/run-k6-load.mjs",
    "vapid:generate": "web-push generate-vapid-keys",
    "test:item1": "tsx scripts/test-item1-security.ts",
    "worker:scheduled": "node --env-file=.env scripts/scheduled-worker.mjs",
    "test:item2": "tsx scripts/test-item2-deployment.ts",
    "audit:dependencies": "tsx scripts/audit-dependencies.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:pwa-offline": "tsx scripts/test-pwa-offline.ts",
    "test:item3": "tsx scripts/test-item3-authorization.ts",
    "test": "npm run test:unit && npm run test:item1 && npm run test:item2 && npm run test:item3 && npm run test:items4-6 && npm run test:remaining && npm run test:restored",
    "test:remaining": "tsx scripts/test-remaining-hardening.ts",
    "test:items4-6": "tsx scripts/test-items4-6.ts",
    "profile:mobile": "node scripts/profile-mobile.mjs",
    "test:scanner": "tsx scripts/test-clamav.ts",
    "test:restored": "tsx scripts/test-restored.ts",
    "test:verification": "tsx scripts/test-verification-codes.ts",
    "test:send": "tsx scripts/test-send-commit.ts",
    "test:verification-template": "tsx scripts/test-verification-template.ts",
    "test:reliability:integration": "tsx --test --test-concurrency=1 tests/integration/reliability.test.ts",
    "test:reliability:browser": "node --import tsx scripts/test-reliability-browser.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.4.3",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "2.117.3",
    "bcrypt": "6.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.4",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.12",
    "lucide-react": "^1.38.0",
    "next": "16.4.1",
    "otpauth": "^9.5.2",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "web-push": "3.6.7",
    "web-vitals": "6.2.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "playwright": "1.63.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.1.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": ">=0.25.12",
    "uuid": ">=11.1.1",
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  }
}
