// Maddy Chats — Prisma schema
// Data layer: PostgreSQL accessed exclusively through Prisma via the Express API.

generator client {
  // The new `prisma-client` generator with the queryCompiler + driverAdapters
  // preview features produces a pure-WASM client that needs NO native Prisma
  // query engine binary at build or runtime.
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "nodejs"
  moduleFormat    = "esm"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // Securely generated identifier (cuid).
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSeenAt   DateTime @default(now())

  @@map("users")
}
