# --- Maddy Chats server environment ---
# Copy this file to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection string used by Prisma.
# For the bundled local database (npm run db:start) the defaults below work.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/maddy_chats?schema=public"

# Secret used to sign JWTs. Use a long, random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Port the API listens on.
PORT=4000

# URL of the frontend, used for CORS and cookie configuration.
CLIENT_URL="http://localhost:5173"

# Environment mode: development | production
NODE_ENV="development"
