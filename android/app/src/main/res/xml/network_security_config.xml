<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Canonical hosted Android builds use HTTPS, including all subrequests. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
