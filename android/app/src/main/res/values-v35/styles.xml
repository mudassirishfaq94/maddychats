<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 otherwise enforces edge-to-edge for target-35 apps. The
         hosted Circlo UI owns its header, so keep WebView content below the
         system status bar instead of overlaying the logo/navigation. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryDark">#FFFFFF</item>
        <item name="colorAccent">#2563EB</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>
</resources>
