<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ZipTalk dark theme — matches the web app's #0b1211 / #0f766e palette -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#0f766e</item>
        <item name="colorPrimaryDark">#0b1211</item>
        <item name="colorAccent">#5eead4</item>
        <item name="android:windowBackground">#0b1211</item>
        <item name="android:statusBarColor">#0b1211</item>
        <item name="android:navigationBarColor">#0b1211</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Prevent content from extending behind the status bar -->
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Splash screen shown while the WebView loads the hosted app -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0b1211</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
