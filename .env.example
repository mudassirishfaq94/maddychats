# PostgreSQL connection string (never expose to the browser)
# For a permanent VPS deployment use Supabase's direct connection string.
# For IPv4-only hosts, use the Supabase Session Pooler connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/maddy_chats
DATABASE_POOL_MAX=5
# Optional dedicated direct/session-pooler URL for LISTEN; defaults to DATABASE_URL.
# Do not use the Supabase transaction pooler (port 6543) here.
REALTIME_DATABASE_URL=

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Required in Docker: private database readiness at /api/ready.
# Public /api/health remains a generic liveness probe.
# Generate with: openssl rand -hex 32
HEALTHCHECK_SECRET=

# Port the Node.js server listens on
PORT=3000

# Public origin of the client app (used for CORS / Origin allow-listing)
CLIENT_URL=http://localhost:3000
# Absolute device expiry (1–90 days). Access cookies expire after 15 minutes.
SESSION_TTL_DAYS=30
# Required for readable uploads in production. Never expose clamd publicly.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Start with nonce-based report-only CSP; enable after checking staging reports.
CSP_ENFORCE=0

# Google OAuth web client. Callback: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Transactional email (password reset)
RESEND_API_KEY=
EMAIL_FROM=ZipTalk <no-reply@your-domain.com>
EMAIL_FROM_NAME=Circlo
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

# Private Supabase Storage. Create the private bucket named `maddy-media`.
# These server-only values are found in Supabase Dashboard → Settings → API.
# When omitted, local development falls back to server/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=maddy-media

# Android/desktop background push. Generate once with: npm run vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Firebase Admin SDK — for FCM native push on Android.
# Create a Firebase project at https://console.firebase.google.com,
# generate a new private key (Project Settings > Service Accounts),
# and paste the values here.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK — used for browser phone-number OTP. These values are public,
# but add your production domain to Firebase Authentication > Settings > Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Keep upload limits appropriate for your reverse proxy and Supabase Storage plan.
MAX_AVATAR_MB=3
MAX_IMAGE_MB=3
MAX_FILE_MB=3

# Development seed only — never configure this in production
# DEV_SEED_PASSWORD=choose-a-local-password

# Independent scheduled-message worker (required in Docker).
CRON_SECRET=
SCHEDULED_INTERVAL_MS=15000
# Public release label baked into the web build.
APP_VERSION=development

# $0 starter: pause uploads/voice and scheduled sends; text chat stays encrypted.
STARTER_MODE=0
