# PostgreSQL connection string (never expose to the browser)
# For a permanent VPS deployment use Supabase's direct connection string.
# For IPv4-only hosts, use the Supabase Session Pooler connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/maddy_chats
DATABASE_POOL_MAX=5
# Optional separate owner credential used only by migration/startup tooling.
# When set, DATABASE_URL and REALTIME_DATABASE_URL should use a limited DML role.
MIGRATION_DATABASE_URL=
# Optional dedicated direct/session-pooler URL for LISTEN; defaults to DATABASE_URL.
# Do not use the Supabase transaction pooler (port 6543) here.
REALTIME_DATABASE_URL=

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Required in Docker: private database readiness at /api/ready.
# Public /api/health remains a generic liveness probe.
# Generate with: openssl rand -hex 32
HEALTHCHECK_SECRET=

# Port the Node.js server listens on
PORT=3000

# Public origin of the client app (used for CORS / Origin allow-listing)
CLIENT_URL=http://localhost:3000
# Render automatically uses its Cloudflare ingress header; leave this empty there.
# Other production hosts: configure the exact trusted X-Forwarded-For hop count
# ONLY after ensuring the app cannot be reached around that proxy. Missing or
# invalid production proxy configuration uses one shared "unknown" abuse bucket.
CLIENT_IP_TRUSTED_HOPS=
# Absolute device expiry (1–90 days). Access cookies expire after 15 minutes.
SESSION_TTL_DAYS=30
# Required for readable uploads in production. Never expose clamd publicly.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Start with nonce-based report-only CSP; enable after checking staging reports.
CSP_ENFORCE=0

# Google OAuth web client. Callback: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Transactional email (password reset)
RESEND_API_KEY=
EMAIL_FROM=Circlo <no-reply@your-domain.com>
EMAIL_FROM_NAME=Circlo
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

# Private media storage. `supabase` is the existing backend; select `r2` only
# after creating the private Cloudflare R2 bucket and migrating existing files.
# R2 and Supabase credentials are server-only; never add NEXT_PUBLIC_ prefixes.
MEDIA_STORAGE_BACKEND=supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=circlo-media
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Existing private Supabase bucket. Keep configured during the R2 migration so
# files not copied yet can still be read and deleted. Remove after verification.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=maddy-media

# Android/desktop background push. Generate once with: npm run vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Firebase Admin SDK — for FCM native push on Android.
# Use the approved existing Firebase project; do not create another project.
# Supply its existing authorized server credential through host secrets, never Android resources.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Keep upload limits appropriate for your reverse proxy and Supabase Storage plan.
MAX_AVATAR_MB=10
MAX_IMAGE_MB=10
MAX_FILE_MB=10

# Development seed only — never configure this in production
# DEV_SEED_PASSWORD=choose-a-local-password

# Independent scheduled-message worker (required in Docker).
CRON_SECRET=
SCHEDULED_INTERVAL_MS=15000
# Public release label baked into the web build.
APP_VERSION=development

# $0 starter: pause uploads/voice, phone auth, Signal provisioning and schedules.
STARTER_MODE=0

# Enable encrypted chat media independently of readable uploads and experimental features.
CHAT_MEDIA_ENABLED=0
# Run the existing scheduler in the web process; free hosts catch up after waking.
SCHEDULED_MESSAGES_ENABLED=0

# Bounded native password work; cost remains 12. Benchmark before changing.
# Allowed: 1–3; defaults to 2 and leaves libuv capacity for other server work.
PASSWORD_CONCURRENCY=2
# Local loopback diagnostics only; disabled for normal production requests.
LOGIN_PERFORMANCE_DIAGNOSTICS=0

# Explicitly owner-confirmed public support/deletion mailbox (not a secret).
# Set on the server at runtime; leave blank until a monitored address is approved.
PUBLIC_SUPPORT_EMAIL=
