# PostgreSQL connection string (never expose to the browser)
DATABASE_URL=postgresql://user:password@localhost:5432/maddy_chats
SESSION_TTL_DAYS=365

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Port the Node.js server listens on
PORT=3000

# Public origin of the client app (used for CORS / Origin allow-listing)
CLIENT_URL=http://localhost:3000

# Google OAuth web client. Callback: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Local media storage (Step 6)
MAX_AVATAR_MB=5
MAX_IMAGE_MB=10
MAX_FILE_MB=25

# Development seed only — never configure this in production
# DEV_SEED_PASSWORD=choose-a-local-password
